# Core
CELERY_ENABLED=true
WORKFLOW_V2_ENABLED=true
WORKFLOW_V2_EXECUTE_M2=true
WORKFLOW_CONTEXTUAL_MEMBER_ROUTING_ENABLED=false
ORCH_QUEUE_PROFILE=prod

# Billing legado e batch (ambos desligados no primeiro deploy)
ORCH_BILLING_SNAPSHOT_ENABLED=false
ORCH_BILLING_ENABLED=false
BILLING_BATCH_SIZE=200
BILLING_FLUSH_INTERVAL_SECONDS=300
BILLING_RETRY_SCAN_INTERVAL_SECONDS=15
BILLING_PROCESSING_LEASE_SECONDS=120
BILLING_RETRY_INITIAL_SECONDS=15
BILLING_RETRY_MAX_SECONDS=3600
BILLING_RETRY_JITTER_SECONDS=10
BILLING_RECONCILE_INTERVAL_SECONDS=300
BILLING_RECONCILE_LOOKBACK_HOURS=48
BILLING_REPROCESS_LEASE_SECONDS=3600
BILLING_REPROCESS_SCAN_INTERVAL_SECONDS=60
BILLING_REPROCESS_CHUNK_SIZE=1000
BILLING_PUBLISH_CONFIRM_TIMEOUT_SECONDS=10
BILLING_PUBLISH_CLAIM_BATCH_SIZE=20
BILLING_RABBITMQ_URL=amqp://billing:change-me@127.0.0.1:5672//
BILLING_EXCHANGE=domain.events
BILLING_ROUTING_KEY=billing.usage.snapshot.v1.target
BILLING_APPLICATION_CODE=target
BILLING_SERVICE_CODE=service-orch
BILLING_METRIC_CODE=service-orch
CELERY_BILLING_QUEUE=orch.billing.outbox
ORCH_BILLING_ADMIN_CLIENT_ID=change-me
ORCH_BILLING_ADMIN_CLIENT_SECRET=change-me

# Broker/Backend (exemplos)
CELERY_BROKER_URL=amqp://admin:admin@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://:redis-pass@127.0.0.1:6379/0

# DB / workspace fallback (ajustar ao ambiente)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=target_core
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=ws_ba7eb0ec-e565-447c-8c11-8f870cf72a60
ORCH_DEFAULT_WORKSPACE_UUID=ba7eb0ec-e565-447c-8c11-8f870cf72a60

# Workflow queues (legacy/runtime)
CELERY_DISPATCH_QUEUE=orch_dispatch
CELERY_EXECUTE_QUEUE=orch_execute
CELERY_SWITCH_BOT_FLOW_QUEUE=orch_switch_bot_flow
CELERY_DIALER_SUPPLIER_V2_QUEUE=orch_dialer_supplier_v2
CELERY_HEARTBEAT_QUEUE=orch_heartbeat

# switch_bot_flow / Target Core
SWITCH_BOT_FLOW_ENABLED=false
SWITCH_BOT_FLOW_HTTP_TIMEOUT_SECONDS=30
SWITCH_BOT_FLOW_MAX_ATTEMPTS=3
SWITCH_BOT_FLOW_RETRY_BACKOFF_SECONDS=1
TARGET_CORE_API_BASE_URL=http://target-core-api.otima.io
TARGET_CORE_API_BEARER_TOKEN=change-me

# Listas de Restrição (perfil Supplier; não apontar para o CRUD)
TARGET_CORE_SUPPLIER_API_BASE_URL=http://target-core-supplier.internal:7502
DIALER_SUPPLIER_V2_ENABLED=false
DIALER_SUPPLIER_V2_WORKSPACE_ALLOWLIST=
DIALER_SUPPLIER_V2_FLOW_ALLOWLIST=
DIALER_SUPPLIER_V2_HTTP_TIMEOUT_SECONDS=5
DIALER_SUPPLIER_V2_MAX_ATTEMPTS=3
DIALER_SUPPLIER_V2_RETRY_BACKOFF_SECONDS=2
DIALER_SUPPLIER_V2_RECONCILE_INTERVAL_SECONDS=30
DIALER_SUPPLIER_V2_RECONCILE_BATCH_SIZE=100
DIALER_SUPPLIER_V2_REGISTRATION_LEASE_SECONDS=120
# Multilane permanece fail-closed e exige também o gate Supplier V2 acima.
ORCH_DIALER_MULTILANE_V2_ENABLED=false
ORCH_DIALER_MULTILANE_V2_FLOW_UUIDS=
ORCH_DIALER_MULTILANE_V2_MAX_LANES_PER_FLOW=1
ORCH_DIALER_MULTILANE_V2_MAX_EXECUTION_GROUPS_PER_FLOW=1
# Habilitar em apenas um Beat do cluster para recuperar o gap commit -> enqueue.
CELERY_BEAT_DIALER_SUPPLIER_V2_RECONCILE_ENABLED=false
RESTRICTION_LIST_CHECK_HTTP_TIMEOUT_SECONDS=5
RESTRICTION_LIST_CHECK_MAX_ATTEMPTS=2
RESTRICTION_LIST_CHECK_RETRY_BACKOFF_SECONDS=0.25

# FileApp queues (isoladas)
CELERY_FILEAPP_INGEST_ENABLED=true
CELERY_S3_FILES_INGEST_QUEUE=orch_fileapp_ingest_events
CELERY_SOURCE_LIST_INGEST_QUEUE=orch_fileapp_source_list_ingest

# Generate File queues (isoladas)
CELERY_GENERATE_FILE_ENABLED=true
CELERY_GENERATE_FILE_SCAN_ENABLED=true
CELERY_GENERATE_FILE_SCAN_INTERVAL_SECONDS=10
CELERY_GENERATE_FILE_RUN_QUEUE=orch_component_generate_file_run
CELERY_GENERATE_FILE_SCAN_QUEUE=orch_component_generate_file_scan

# Docs access control (interno/VPN permitido; externo bloqueado)
DOCS_ACCESS_CONTROL_ENABLED=true
DOCS_INTERNAL_CIDRS=10.1.20.0/24,10.100.105.0/24,127.0.0.1/32,::1/128
DOCS_TRUSTED_PROXY_CIDRS=10.1.20.130/32
DOCS_BLOCKED_HOSTS=orch.otima.digital
